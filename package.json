{
  "name": "classroom-emotions-tools",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "emu:start": "node scripts/start-emulators.mjs",
    "emu:start:fresh": "node scripts/start-emulators.mjs --no-restore",
    "emu:save": "node scripts/emu-snapshot.mjs",
    "emu:save:full": "node scripts/emu-snapshot.mjs --jsonbak",
    "emu:backup": "node scripts/backup-firestore.mjs && node scripts/backup-auth.mjs",
    "emu:restore": "node scripts/restore-firestore.mjs && node scripts/restore-auth.mjs",
    "cloud:upload": "node scripts/upload-to-cloud.mjs",
    "seed:lectures": "node scripts/seed-lectures.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.9.0",
    "firebase-tools": "^15.17.0"
  }
}
