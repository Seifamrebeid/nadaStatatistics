# Copy this file to .env and fill in the real values.
# Never commit a real API key in this template — keep secrets in .env (gitignored).

# === Brevo (transactional email) ===========================================
# 1. Sign up at https://www.brevo.com (free tier: 300 emails/day)
# 2. Settings -> SMTP & API -> API Keys -> Generate new
# 3. Senders, Domains & Dedicated IPs -> Senders -> add + verify a sender email
BREVO_API_KEY=xkeysib-PUT-YOUR-KEY-HERE
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=Classroom Emotion Detection

# === Firebase project + emulator ============================================
FIREBASE_PROJECT_ID=fridgechef-jt50c
FIRESTORE_EMULATOR_HOST=localhost:8080

# === This server ============================================================
PORT=8001
# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# === Mode ===================================================================
# stub  -> don't actually call Brevo, just write the audit row (great for dev)
# live  -> hit Brevo for real
SEND_MODE=live
