# Copy to .env and fill in. .env is gitignored.

# Firebase project
FIREBASE_PROJECT_ID=emotion-detection-dev

# Emulator mode — leave these set during development. firebase-admin auto-connects
# to the emulator when these hosts are set; no real credentials are needed.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Real Firebase (prod) — leave the path empty to stay in emulator mode.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Capture config
CSV_PATH=../data/emotions.csv
CAMERA_INDEX=0
PROCESS_EVERY_N_FRAMES=30
SAVE_INTERVAL_SECONDS=3
FACE_MATCH_TOLERANCE=0.6

# Sleep-detection thresholds.
# EAR below this for N consecutive frames (every-frame pipeline at ~30 fps) = eyes closed.
# 0.20 is strict; 0.25 is what most faces land between "eyes open" and "eyes closed".
# If false positives on blinks at 0.25, drop to 0.23.
EAR_CLOSED_THRESHOLD=0.25
EAR_CLOSED_FRAMES=15
HEAD_DOWN_PITCH_DEG=-20
HEAD_DOWN_FRAMES=15

# Gesture-detection thresholds
GESTURE_HOLD_FRAMES=8

# Audio + transcription
AUDIO_SAMPLE_RATE=16000
AUDIO_DEVICE_INDEX=
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ar
WHISPER_INITIAL_PROMPT=هذه محاضرة باللغة العربية باللهجة المصرية. كلمات المحاضرة: الاحتمال، المتوسط، الانحراف المعياري، الفرضية الصفرية، القيمة الاحتمالية.

# Streaming transcription
STREAM_MAX_CHUNK_SEC=28
STREAM_MIN_CHUNK_SEC=2
STREAM_VAD_THRESHOLD=0.45
STREAM_CONTEXT_TOKENS=224

# Plumber backend (used for the /finalize call at end of lecture)
PLUMBER_URL=http://localhost:8000
FINALIZE_SHARED_SECRET=
