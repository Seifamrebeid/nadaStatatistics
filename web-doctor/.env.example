# Copy this to .env and fill in real values. .env is gitignored.

# Brevo (transactional email) — used by DoctorNotifications.jsx
# 1. Sign up at https://www.brevo.com (free tier: 300 emails/day)
# 2. Settings -> SMTP & API -> API Keys -> Generate
# 3. Senders, Domains & Dedicated IPs -> Senders -> add + verify a sender email
VITE_BREVO_API_KEY=xkeysib-PUT-YOUR-KEY-HERE
VITE_BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
VITE_BREVO_SENDER_NAME=Classroom Emotion Detection
